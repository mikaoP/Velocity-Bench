# This is a comment
# Ignore target at the top level
/build/
/Build/
/bin/
/Bin/
# Ignore child project's targets as well
/*/build/
/*/Build/
/*/bin/
/*/Bin/

# And any grandchildren ...
/*/*/build/
/*/*/Build/
/*/*/bin/
/*/*/Bin/

# Or you can do:
*build*/
*Build*/
*bin*/
*Bin*/

# which matches 'target' in any sub folder
*.syntastic_cpp_config

